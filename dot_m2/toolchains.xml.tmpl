<?xml version="1.0" encoding="UTF-8"?>
<toolchains>
  <toolchain>
    <type>jdk</type>
    <provides>
      <version>8</version>
      <vendor>Temurin</vendor>
    </provides>
    <configuration>
      <jdkHome>
        {{- if eq $.chezmoi.os "windows" -}}
        ${env.USERPROFILE}\scoop\apps\temurin8-jdk\current
        {{- else if eq $.chezmoi.os "darwin" -}}
        /Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home
        {{- end -}}
      </jdkHome>
    </configuration>
  </toolchain>

  {{- range $javaVersion := list 11 17 21 25 }}

  <toolchain>
    <type>jdk</type>
    <provides>
      <version>{{ $javaVersion }}</version>
      <vendor>Eclipse Adoptium</vendor>
    </provides>
    <configuration>
      <jdkHome>
        {{- if eq $.chezmoi.os "windows" -}}
        ${env.USERPROFILE}\scoop\apps\temurin{{ $javaVersion }}-jdk\current
        {{- else if eq $.chezmoi.os "darwin" -}}
        /Library/Java/JavaVirtualMachines/temurin-{{ $javaVersion }}.jdk/Contents/Home
        {{- end -}}
      </jdkHome>
    </configuration>
  </toolchain>
  {{- end }}
</toolchains>
